# EmailJS credentials — get these from https://dashboard.emailjs.com
# Copy this file to ".env" and fill in your real values.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# --- Google landing page (/google-landing) booking form ---
# Optional. Lets campaign leads arrive via their own template / inbox so they
# stay separate from the main site's contact form. Each falls back to the
# value above if left unset.
VITE_EMAILJS_BOOKING_TEMPLATE_ID=your_booking_template_id
VITE_BOOKING_LEAD_EMAIL=leads@example.com
